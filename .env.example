# Copy to .env and fill MySQL secrets before docker compose up.
# MYSQL_USER cannot be root. Empty MySQL passwords are not allowed.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=oxid
MYSQL_USER=oxid
MYSQL_PASSWORD=

# Shop admin for step 3 (oe:admin:create-user). Unused by compose.
ADMIN_EMAIL=admin@localhost.local
ADMIN_PASSWORD=

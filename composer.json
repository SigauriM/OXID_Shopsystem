{
    "name": "oxid-esales/oxideshop-project",
    "type": "project",
    "description": "OXID eShop 7.5 CE with a shipping module that prices by length, girth, weight and postcode",
    "license": "proprietary",
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "path",
            "url": "packages/shipping-engine"
        },
        {
            "type": "path",
            "url": "packages/shipping-module"
        }
    ],
    "require": {
        "oxid-esales/oxideshop-metapackage-ce": "v7.5.0",
        "oxid-shipping/module": "*@dev",
        "oxid-shipping/engine": "*@dev"
    },
    "autoload-dev": {
        "psr-4": {
            "OxidEsales\\EshopCommunity\\Tests\\": "./vendor/oxid-esales/oxideshop-ce/tests"
        }
    },
    "config": {
        "prepend-autoloader": false,
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "oxid-esales/oxideshop-composer-plugin": true,
            "oxid-esales/oxideshop-unified-namespace-generator": true
        }
    }
}

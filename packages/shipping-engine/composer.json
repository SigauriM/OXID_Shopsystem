{
    "name": "oxid-shipping/engine",
    "description": "Shipping calculation engine (stage 1 core)",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "OxidShipping\\Engine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OxidShipping\\Engine\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "authors": [
        {
            "name": "SigauriM",

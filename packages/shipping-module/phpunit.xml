<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../shipping-engine/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnEmptyTestSuite="true">
    <testsuites>
        <!-- Integration requires a live shop; CI invokes the Module suite only. -->
        <testsuite name="Module">
            <directory>tests</directory>
            <exclude>tests/TariffRepositoryIntegrationTest.php</exclude>
        </testsuite>
        <testsuite name="Integration">
            <file>tests/TariffRepositoryIntegrationTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src/Logging</directory>
            <directory>src/Mapping</directory>
            <directory>src/Quote</directory>
            <directory>src/Tariff</directory>
            <directory>src/Admin</directory>
            <directory>src/Sandbox</directory>
            <directory>src/Seo</directory>
        </include>
    </source>
</phpunit>
